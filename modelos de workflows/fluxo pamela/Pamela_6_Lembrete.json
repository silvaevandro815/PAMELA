      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Extract phone number from calendar event description\nconst item = $input.item.json;\n\n// Extract phone number from description using regex\nconst description = item.description || '';\nconst phoneMatch = description.match(/Telefone:\\s*([\\d\\s\\-\\(\\)]+)/);\n\nlet phoneNumber = '';\nif (phoneMatch && phoneMatch[1]) {\n  // Clean phone number to only digits\n  phoneNumber = phoneMatch[1].replace(/\\D/g, '');\n}\n\n// Format start time\nconst startTime = item.start?.dateTime || item.start?.date || '';\n\n// Return event data with extracted phone number and formatted start time\nreturn {\n  json: {\n    eventId: item.id,\n    summary: item.summary,\n    description: item.description,\n    phoneNumber: phoneNumber,\n    startTime: startTime,\n    originalEvent: item\n  }\n};"
      },
