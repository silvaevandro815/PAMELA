        "query": "SELECT \n  COALESCE(SUM(valor), 0) as faturamento_mes \nFROM transacoes \nWHERE tipo = 'RECEITA' \n  AND status = 'PAGO' \n  AND extract(month from data_pagamento) = extract(month from current_date);",
        "options": {}
